# API pública de Notry, sin slash final.
VITE_NOTRY_API_BASE=http://localhost:8000/api/v1

# UUID del Project configurado con finance_config y ofertas por lote.
# Opcional: solo se usa si la URL no trae slug (ej. deploy mono-proyecto en la raíz "/").
# Si la URL es "/<slug>", el proyecto se resuelve por slug contra el backend y esta variable se ignora.
VITE_NOTRY_PROJECT_ID=

# URL del visor 360 público, sin slash final.
VITE_NOTRY_VISOR_URL=https://notry-visor.vercel.app
